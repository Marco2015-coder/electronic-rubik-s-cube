{
  "name": "electronic-rubik-s-cube",
  "version": "0.1.0",
  "private": true,
  "description": "电子魔方 —— 基于 Electron + TypeScript 的三维魔方游戏",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/ui/index.ts --bundle --format=iife --outfile=dist/ui/bundle.js --target=chrome120 --sourcemap",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "start": "npm run build && electron .",
    "start:only": "electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "preview": "node scripts/preview.mjs",
    "smoke": "npm run build && electron . --smoke",
    "selftest": "npm run build:main && node scripts/selftest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
